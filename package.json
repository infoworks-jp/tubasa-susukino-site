{
  "name": "tubasa-susukino-site",
  "private": true,
  "scripts": {
    "build:seo": "node scripts/build-seo.mjs",
    "test:seo": "node scripts/build-seo.mjs --check && node tests/seo-qa.mjs",
    "build:fluid": "esbuild fluid-text.js --bundle --format=esm --target=es2022 --minify --outfile=vendor/fluid-text.bundle.js",
    "build:ai": "node scripts/build-ai-data.mjs",
    "test:ai": "node scripts/build-ai-data.mjs --check && node tests/ai-chat-qa.mjs",
    "test": "npm run test:seo && npm run test:ai && node tests/deploy-contract-qa.mjs && npm run test:stories",
    "build:location": "esbuild location/city.source.mjs --bundle --format=esm --minify --outfile=location/city.bundle.js",
    "test:stories": "node tests/stories-qa.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "maplibre-gl": "^6.8.0",
    "meshoptimizer": "1.0.1",
    "three": "0.183.2",
    "three-fluid-fx": "0.1.0",
    "three-mesh-bvh": "0.9.16"
  }
}
